NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/atlas
PERSISTENCE_SECRET_KEY=
REQUIRE_DURABLE_PERSISTENCE=false
ADMIN_EMAIL=admin@jackson.com
ADMIN_PASSWORD=password123
USER_EMAIL=user@jackson.com
USER_PASSWORD=password123
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_PARALLELISM=1
SESSION_COOKIE_NAME=atlas_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
AUTH_LOCKOUT_THRESHOLD=3
AUTH_LOCKOUT_MINUTES=30
# Server-owned login enforcement switch. Defaults to false when unset or invalid.
# Change this value and restart/redeploy the API; no web rebuild is required.
MFA_LOGIN_ENABLED=false
TOTP_ISSUER=Jackson
STORAGE_ROOT=./.storage
K1_UPLOAD_MAX_BYTES=26214400
K1_UPLOAD_MAX_PAGES=100
K1_BATCH_MAX_FILES=25
K1_UPLOAD_URL_TTL_SECONDS=900
# Production rollout switch. Keep false for local/stub, migrations, and any
# environment that has not passed the staging gates.
K1_AWS_INGESTION_ENABLED=false
K1_OBJECT_STORE=local
K1_QUEUE=local
K1_WORKER_CONCURRENCY=10
K1_RECONCILIATION_STALE_SECONDS=300
K1_RECONCILIATION_INTERVAL_SECONDS=15

# Extractor backend: stub (offline/CI default) | aws_bda (real AWS BDA)
# K1_EXTRACTOR=stub

# AWS K-1 ingestion. Local BDA development should keep K1_QUEUE=local and use
# `npm run dev:local:bda`; deployed AWS environments use SQS.
K1_S3_BUCKET=
K1_KMS_KEY_ARN=
K1_S3_INPUT_PREFIX=originals
K1_S3_OUTPUT_PREFIX=extraction-results
K1_WORK_QUEUE_URL=
K1_COMPLETION_QUEUE_URL=
K1_BDA_PROFILE_ARN=
K1_BDA_PROJECT_ARN=
K1_BDA_PROJECT_STAGE=DEVELOPMENT
K1_BDA_BLUEPRINT_ARN=
K1_BDA_BLUEPRINT_VERSION=
K1_MAPPING_SCHEMA_VERSION=k1-form-1065-v1
K1_BEDROCK_CHECKBOX_MODEL_ID=us.amazon.nova-2-lite-v1:0
K1_BEDROCK_CHECKBOX_MAX_BYTES=5242880

# Plaid Investments integration
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=investments
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=

# Liquidity Plaid refresh policy
PLAID_REFRESH_TIME_LOCAL=05:00
PLAID_REFRESH_TIMEZONE=America/Los_Angeles
PLAID_REFRESH_SCHEDULER_ENABLED=false
PLAID_REFRESH_SCHEDULER_MODE=none
ATLAS_SCHEDULER_TOKEN=

# Public-market pricing. Keep credentials server-side; never expose them to Vite.
# Use sip for consolidated US exchange coverage, iex for lower-cost partial coverage,
# or delayed_sip where the account entitlement only permits delayed SIP data.
MARKET_DATA_PROVIDER=none
MARKET_DATA_REFRESH_ON_READ=true
MARKET_DATA_MAX_AGE_SECONDS=60
MARKET_DATA_REQUEST_TIMEOUT_MS=4000
ALPACA_MARKET_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_MARKET_DATA_KEY_ID=
ALPACA_MARKET_DATA_SECRET=
ALPACA_MARKET_DATA_FEED=sip
MASSIVE_OTC_ENABLED=false
MASSIVE_MARKET_DATA_BASE_URL=https://api.massive.com
MASSIVE_MARKET_DATA_API_KEY=
MASSIVE_OTC_CACHE_TTL_SECONDS=900

# API production guardrails
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
API_SHARED_CACHE_POLICY=no_shared_cache
PRODUCTION_READINESS_ENABLED=true

# AWS deployment metadata
AWS_REGION=us-west-2
AWS_APP_DOMAIN=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
AWS_WEB_ASSETS_BUCKET=
