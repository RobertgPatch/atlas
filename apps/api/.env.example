NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/atlas
PERSISTENCE_SECRET_KEY=
REQUIRE_DURABLE_PERSISTENCE=false
ADMIN_EMAIL=admin@jackson.com
ADMIN_PASSWORD=password123
USER_EMAIL=user@jackson.com
USER_PASSWORD=password123
SESSION_COOKIE_NAME=atlas_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_TIMEOUT_SECONDS=900
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
AUTH_LOCKOUT_THRESHOLD=3
AUTH_LOCKOUT_MINUTES=30
TOTP_ISSUER=Jackson
STORAGE_ROOT=./.storage
K1_UPLOAD_MAX_BYTES=26214400

# Azure Document Intelligence — K-1 extraction backend
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-subscription-key>
# AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
# AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=<your-custom-or-composed-model-id>

# Extractor backend: stub (offline/CI default) | azure (real API)
# K1_EXTRACTOR=stub

# Plaid Investments integration
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=investments
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=

# Liquidity Plaid refresh policy
PLAID_REFRESH_TIME_LOCAL=05:00
PLAID_REFRESH_TIMEZONE=America/Los_Angeles
PLAID_REFRESH_SCHEDULER_ENABLED=false
PLAID_REFRESH_SCHEDULER_MODE=none
ATLAS_SCHEDULER_TOKEN=

# Public-market pricing. Keep credentials server-side; never expose them to Vite.
# Use sip for consolidated US exchange coverage, iex for lower-cost partial coverage,
# or delayed_sip where the account entitlement only permits delayed SIP data.
MARKET_DATA_PROVIDER=none
MARKET_DATA_REFRESH_ON_READ=true
MARKET_DATA_MAX_AGE_SECONDS=60
MARKET_DATA_REQUEST_TIMEOUT_MS=4000
ALPACA_MARKET_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_MARKET_DATA_KEY_ID=
ALPACA_MARKET_DATA_SECRET=
ALPACA_MARKET_DATA_FEED=sip
MASSIVE_OTC_ENABLED=false
MASSIVE_MARKET_DATA_BASE_URL=https://api.massive.com
MASSIVE_MARKET_DATA_API_KEY=
MASSIVE_OTC_CACHE_TTL_SECONDS=900

# API production guardrails
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
API_SHARED_CACHE_POLICY=no_shared_cache
PRODUCTION_READINESS_ENABLED=true

# AWS deployment metadata
AWS_REGION=us-west-2
AWS_APP_DOMAIN=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
AWS_WEB_ASSETS_BUCKET=
