# Copy this file to apps/api/.env.local-bda. The destination is ignored by Git.
# These are resource identifiers, not credentials. Authenticate separately with
# an approved short-lived AWS CLI profile/session before starting local BDA.
ATLAS_LOCAL_BDA_ACCOUNT_ID=111122223333
AWS_PROFILE=replace-with-approved-profile
AWS_REGION=us-west-2

# Use the production K-1 resources created by Terraform. Do not use retired
# staging resources, SQS URLs, database endpoints, or broad mutation flags.
K1_S3_BUCKET=replace-with-k1-document-bucket
K1_KMS_KEY_ARN=arn:aws:kms:us-west-2:111122223333:key/replace-with-key-id
K1_BDA_PROFILE_ARN=arn:aws:bedrock:us-west-2:111122223333:data-automation-profile/us.data-automation-v1
K1_BDA_PROJECT_ARN=arn:aws:bedrock:us-west-2:111122223333:data-automation-project/replace-with-project-id

# Optional immutable extraction metadata when the project exposes it.
K1_BDA_BLUEPRINT_ARN=
K1_BDA_BLUEPRINT_VERSION=
K1_MAPPING_SCHEMA_VERSION=k1-form-1065-v1

# Explicit local paid-work ceilings. Keep these small and increase only after a
# deliberate cost review. One document uses one upload unit and one BDA unit.
ABUSE_K1_GLOBAL_FILES_PER_MONTH=5
ABUSE_K1_BDA_CALLS_PER_MONTH=10
ABUSE_PAID_WORKLOAD_MONTHLY_BUDGET_CENTS=25000
ABUSE_BDA_MAX_ATTEMPTS=1
ABUSE_K1_USER_FILES_PER_DAY=3
ABUSE_K1_GLOBAL_FILES_PER_DAY=3
ABUSE_K1_USER_DOCUMENTS_PER_DAY=3
ABUSE_K1_GLOBAL_DOCUMENTS_PER_DAY=3
ABUSE_K1_EXTRACTION_GLOBAL_IN_FLIGHT=1

# Poll submitted BDA jobs promptly during an interactive local session.
K1_RECONCILIATION_STALE_SECONDS=5
K1_RECONCILIATION_INTERVAL_SECONDS=5
