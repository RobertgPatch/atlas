{
  "name": "@jackson/types",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./liquidity-sectors": {
      "types": "./dist/liquidity-sectors.d.ts",
      "default": "./dist/liquidity-sectors.js"
    },
    "./liquidity-statements": {
      "types": "./dist/liquidity-statements.d.ts",
      "default": "./dist/liquidity-statements.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  }
}
