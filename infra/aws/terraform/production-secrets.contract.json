{
  "schemaVersion": "1.0.0",
  "namePrefix": "atlas-production",
  "awsRegion": "us-west-2",
  "secrets": [
    {
      "key": "DATABASE_URL",
      "nameSuffix": "DATABASE_URL",
      "consumers": ["api", "plaid-scheduler", "market-scheduler", "k1-worker"],
      "requiredWhen": "always",
      "persistenceCritical": true
    },
    {
      "key": "PERSISTENCE_SECRET_KEY",
      "nameSuffix": "PERSISTENCE_SECRET_KEY",
      "consumers": ["api", "plaid-scheduler", "market-scheduler", "k1-worker"],
      "requiredWhen": "always",
      "persistenceCritical": true
    },
    {
      "key": "SESSION_SECRET",
      "nameSuffix": "SESSION_SECRET",
      "consumers": ["api"],
      "requiredWhen": "always",
      "persistenceCritical": true
    },
    {
      "key": "ABUSE_HMAC_ACTIVE_KEY",
      "nameSuffix": "ABUSE_HMAC_ACTIVE_KEY",
      "consumers": ["api", "plaid-scheduler", "market-scheduler", "k1-worker"],
      "requiredWhen": "always",
      "persistenceCritical": true
    },
    {
      "key": "PLAID_CLIENT_ID",
      "nameSuffix": "PLAID_CLIENT_ID",
      "consumers": ["api", "plaid-scheduler"],
      "requiredWhen": "plaidEnabled",
      "persistenceCritical": false
    },
    {
      "key": "PLAID_SECRET",
      "nameSuffix": "PLAID_SECRET",
      "consumers": ["api", "plaid-scheduler"],
      "requiredWhen": "plaidEnabled",
      "persistenceCritical": false
    },
    {
      "key": "PROJECT_JACKSON_SCHEDULER_TOKEN",
      "nameSuffix": "PROJECT_JACKSON_SCHEDULER_TOKEN",
      "consumers": ["api", "plaid-scheduler"],
      "requiredWhen": "plaidSchedulerEnabled",
      "persistenceCritical": false
    },
    {
      "key": "ALPACA_MARKET_DATA_KEY_ID",
      "nameSuffix": "ALPACA_MARKET_DATA_KEY_ID",
      "consumers": ["api", "market-scheduler"],
      "requiredWhen": "marketDataAlpacaEnabled",
      "persistenceCritical": false
    },
    {
      "key": "ALPACA_MARKET_DATA_SECRET",
      "nameSuffix": "ALPACA_MARKET_DATA_SECRET",
      "consumers": ["api", "market-scheduler"],
      "requiredWhen": "marketDataAlpacaEnabled",
      "persistenceCritical": false
    },
    {
      "key": "ADMIN_PASSWORD",
      "nameSuffix": "ADMIN_PASSWORD",
      "consumers": ["api"],
      "requiredWhen": "always",
      "persistenceCritical": false
    },
    {
      "key": "USER_PASSWORD",
      "nameSuffix": "USER_PASSWORD",
      "consumers": ["api"],
      "requiredWhen": "always",
      "persistenceCritical": false
    }
  ],
  "runtimeNonSecretVariables": ["PLAID_ENV"],
  "retiredSecretKeys": ["PLAID_ENV", "ATLAS_SCHEDULER_TOKEN"],
  "retainedLegacyMetadata": ["PLAID_ENV"]
}
