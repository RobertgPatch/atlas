{
  "schemaVersion": "1.0.0",
  "namePrefix": "atlas-production",
  "awsRegion": "us-west-2",
  "secrets": [
    {
      "key": "DATABASE_URL",
      "nameSuffix": "DATABASE_URL",
      "consumers": ["api", "market-scheduler", "k1-worker"],
      "requiredWhen": "always",
      "persistenceCritical": true
    },
    {
      "key": "PERSISTENCE_SECRET_KEY",
      "nameSuffix": "PERSISTENCE_SECRET_KEY",
      "consumers": ["api", "market-scheduler", "k1-worker"],
      "requiredWhen": "always",
      "persistenceCritical": true
    },
    {
      "key": "SESSION_SECRET",
      "nameSuffix": "SESSION_SECRET",
      "consumers": ["api"],
      "requiredWhen": "always",
      "persistenceCritical": true
    },
    {
      "key": "ABUSE_HMAC_ACTIVE_KEY",
      "nameSuffix": "ABUSE_HMAC_ACTIVE_KEY",
      "consumers": ["api", "market-scheduler", "k1-worker"],
      "requiredWhen": "always",
      "persistenceCritical": true
    },
    {
      "key": "ALPACA_MARKET_DATA_KEY_ID",
      "nameSuffix": "ALPACA_MARKET_DATA_KEY_ID",
      "consumers": ["api", "market-scheduler"],
      "requiredWhen": "marketDataAlpacaEnabled",
      "persistenceCritical": false
    },
    {
      "key": "ALPACA_MARKET_DATA_SECRET",
      "nameSuffix": "ALPACA_MARKET_DATA_SECRET",
      "consumers": ["api", "market-scheduler"],
      "requiredWhen": "marketDataAlpacaEnabled",
      "persistenceCritical": false
    },
    {
      "key": "ADMIN_PASSWORD",
      "nameSuffix": "ADMIN_PASSWORD",
      "consumers": ["api"],
      "requiredWhen": "always",
      "persistenceCritical": false
    },
    {
      "key": "SUPER_ADMIN_PASSWORD",
      "nameSuffix": "SUPER_ADMIN_PASSWORD",
      "consumers": ["api"],
      "requiredWhen": "always",
      "persistenceCritical": false
    }
  ],
  "runtimeNonSecretVariables": [],
  "retiredSecretKeys": ["PLAID_CLIENT_ID", "PLAID_SECRET", "PLAID_ENV", "PROJECT_JACKSON_SCHEDULER_TOKEN", "ATLAS_SCHEDULER_TOKEN", "USER_PASSWORD"],
  "retainedLegacyMetadata": []
}
