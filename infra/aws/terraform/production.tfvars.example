# Copy to ignored production.tfvars before planning. Keep real domains, emails,
# account-specific ids, and secrets out of commits.

environment_name         = "production"
environment_cost_profile = "production"
project_name             = "atlas"
aws_region               = "us-west-2"

app_domain             = "app.example.com"
route53_hosted_zone_id = null
acm_certificate_arn    = null

availability_zones  = ["us-west-2a", "us-west-2b"]
vpc_cidr            = "10.42.0.0/16"
public_subnet_cidrs = ["10.42.0.0/24", "10.42.1.0/24"]
private_subnet_cidrs = [
  "10.42.10.0/24",
  "10.42.11.0/24",
]

enable_nat_gateway = true

api_image_tag            = "latest"
api_desired_count        = 1
api_task_cpu             = "512"
api_task_memory          = "1024"
# Set true only after staging validation; changing it requires an API restart/redeploy.
mfa_login_enabled        = false
ecr_force_delete         = false
ecr_image_tag_mutability = "MUTABLE"

database_instance_class           = "db.t4g.micro"
database_allocated_storage_gb     = 20
database_max_allocated_storage_gb = 100
database_backup_retention_days    = 7
database_deletion_protection      = true
database_skip_final_snapshot      = false

secret_recovery_window_days = 30

plaid_refresh_time_local = "05:00"
plaid_refresh_timezone   = "America/Los_Angeles"
scheduler_enabled        = true

# Populate the generated Alpaca Secrets Manager entries before deployment.
market_data_provider               = "alpaca"
alpaca_market_data_feed            = "sip"
market_data_refresh_on_read        = true
market_data_max_age_seconds        = 60
market_price_refresh_time_local    = "16:20"
market_price_refresh_timezone      = "America/New_York"
market_price_scheduler_enabled     = true

log_retention_days     = 30
waf_log_retention_days = 30

waf_rate_limit_requests_per_5_minutes = 1000
monthly_budget_limit_usd              = 100
budget_notification_thresholds        = [50, 80, 100]

cloudfront_price_class = "PriceClass_100"

additional_tags = {
  Workload = "liquidity"
  Tier     = "production"
}

# Optional notification destinations. Use real emails only in local tfvars.
alarm_email        = null
budget_alert_email = null
