# Copy to ignored production.tfvars before planning. Keep real domains, emails,
# account-specific ids, and secrets out of commits.

environment_name         = "production"
environment_cost_profile = "production"
project_name             = "atlas"
aws_region               = "us-west-2"

app_domain             = "app.example.com"
route53_hosted_zone_id = null
acm_certificate_arn    = null

availability_zones  = ["us-west-2a", "us-west-2b"]
vpc_cidr            = "10.42.0.0/16"
public_subnet_cidrs = ["10.42.0.0/24", "10.42.1.0/24"]
private_subnet_cidrs = [
  "10.42.10.0/24",
  "10.42.11.0/24",
]

enable_nat_gateway = true

# Prepare overrides this placeholder in the saved plan with the exact source commit.
api_image_tag     = "0000000000000000000000000000000000000000"
api_desired_count = 1
api_task_cpu      = "256"
api_task_memory   = "512"
# Production activation requires MFA; local development tests the same flow separately.
mfa_login_enabled           = true
ecr_force_delete            = false
ecr_image_tag_mutability    = "IMMUTABLE"
ecr_max_images              = 10
ecr_untagged_retention_days = 3

database_instance_class           = "db.t4g.micro"
database_multi_az                  = false
database_allocated_storage_gb     = 20
database_max_allocated_storage_gb = 100
database_backup_retention_days    = 35
database_deletion_protection      = true
database_skip_final_snapshot      = false
# For a migration, set the destination-account snapshot identifier and keep
# password management false on the restore apply. Set it true on the next apply.
database_snapshot_identifier          = null
database_manage_master_user_password = true

secret_recovery_window_days = 30

plaid_refresh_time_local = "05:00"
plaid_refresh_timezone   = "America/Los_Angeles"
scheduler_enabled        = true

# Populate the generated Alpaca Secrets Manager entries before deployment.
market_data_provider               = "alpaca"
alpaca_market_data_feed            = "sip"
market_data_refresh_on_read        = false
market_data_max_age_seconds        = 60
market_price_refresh_time_local    = "16:20"
market_price_refresh_timezone      = "America/New_York"
market_price_scheduler_enabled     = true

log_retention_days     = 30
waf_log_retention_days = 30

waf_rate_limit_requests_per_5_minutes                           = 1000
waf_api_general_rate_action                                     = "block"
waf_auth_rate_limit_requests_per_5_minutes                      = 100
waf_auth_rate_action                                            = "block"
waf_paid_admission_rate_limit_requests_per_5_minutes            = 100
waf_paid_admission_rate_action                                  = "block"
waf_paid_admission_global_emergency_requests_per_5_minutes      = 500
waf_paid_admission_global_emergency_action                      = "block"
monthly_budget_limit_usd                                        = 125
budget_notification_thresholds                                  = [50, 80, 100]
budget_forecast_notification_thresholds                         = [80, 100]
bedrock_monthly_budget_limit_usd                                = 25
bedrock_budget_notification_thresholds                          = [50, 80, 100]
bedrock_budget_forecast_notification_thresholds                 = [80, 100]
cost_anomaly_threshold_usd                                      = 10

cloudfront_price_class = "PriceClass_100"

# Paid K-1 ingestion starts disabled for the one-user baseline. Enabling it
# requires a refreshed cost estimate and active-component alarms.
k1_aws_ingestion_enabled = false
k1_worker_desired_count  = 0

additional_tags = {
  Workload = "liquidity"
  Tier     = "production"
}

# Production plans intentionally fail until real, monitored destinations replace
# these nulls and both confirmations are explicitly set true in an ignored tfvars.
alarm_email                  = null
alarm_destination_confirmed  = false
budget_alert_email           = null
budget_destination_confirmed = false
