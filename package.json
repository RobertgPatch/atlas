{
  "name": "jackson",
  "private": true,
  "version": "0.1.0",
  "description": "Jackson monorepo — Fastify API, Vite/React web, and shared TypeScript packages.",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "axios": "^1.19.0",
    "form-data": "^4.0.6",
    "tmp": "^0.2.7",
    "fast-uri": "^3.1.5",
    "find-my-way": "^9.9.0",
    "uuid": "^11.1.1",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4"
  },
  "scripts": {
    "build:api": "npm run --workspace=api build",
    "start:api": "npm run --workspace=api start",
    "dev:api": "npm run --workspace=api dev",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d postgres",
    "dev:db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -f docker-compose.dev.yml down -v",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:local:bda": "powershell -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -K1Mode bda",
    "deploy:aws:staging": "powershell -ExecutionPolicy Bypass -File scripts/deploy-to-aws-staging.ps1",
    "security:audit:runtime": "node scripts/security/audit-runtime-dependencies.mjs",
    "security:route-policy": "npm run --workspace=api test -- abuse-protection/route-policy-coverage.contract.test.ts",
    "security:cost-envelope": "node scripts/security/validate-cost-envelope.mjs",
    "security:abuse:bounded": "node scripts/security/run-bounded-abuse-tests.mjs",
    "build:web": "npm run --workspace=web build",
    "test:api": "npm run --workspace=api test",
    "test:web": "npm run --workspace=web test",
    "test:current-surface": "npm run --workspace=web check:current-surface",
    "test:pruning": "node --test scripts/pruning/find-unreachable-web.test.mjs",
    "check:web-reachability": "node scripts/pruning/find-unreachable-web.mjs --check"
  }
}
