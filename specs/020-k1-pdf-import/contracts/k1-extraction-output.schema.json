{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackson.local/schemas/k1-extraction-output.schema.json",
  "title": "Exhaustive Schedule K-1 Extraction Output",
  "description": "Source-faithful semantic output before deterministic Atlas field mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "formType",
    "document",
    "items",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^k1-extraction-v[0-9]+$"
    },
    "formType": {
      "const": "1065_SCHEDULE_K1"
    },
    "document": {
      "$ref": "#/$defs/documentMetadata"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/extractedItem"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "itemKey"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 100 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "itemKey": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "nullableText": {
      "type": ["string", "null"],
      "maxLength": 10000
    },
    "money": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "documentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxYear",
        "isFinal",
        "isAmended",
        "partnershipName",
        "partnershipEin",
        "partnerName",
        "partnerTin",
        "pageCount",
        "containsMultipleK1Forms"
      ],
      "properties": {
        "taxYear": {
          "type": ["integer", "null"],
          "minimum": 1900,
          "maximum": 2100
        },
        "isFinal": { "type": ["boolean", "null"] },
        "isAmended": { "type": ["boolean", "null"] },
        "partnershipName": { "$ref": "#/$defs/nullableText" },
        "partnershipEin": { "$ref": "#/$defs/nullableText" },
        "partnerName": { "$ref": "#/$defs/nullableText" },
        "partnerTin": { "$ref": "#/$defs/nullableText" },
        "pageCount": { "type": ["integer", "null"], "minimum": 1 },
        "containsMultipleK1Forms": { "type": "boolean" }
      }
    },
    "extractedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemKey",
        "kind",
        "sourceField",
        "box",
        "code",
        "label",
        "statementReference",
        "rawText",
        "normalizedText",
        "normalizedAmount",
        "normalizedBoolean",
        "needsReview",
        "explanation",
        "evidence"
      ],
      "properties": {
        "itemKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Stable source concept key within this output, not an Atlas destination key."
        },
        "kind": {
          "type": "string",
          "enum": [
            "IDENTIFIER",
            "DATE",
            "CHECKBOX",
            "PERCENTAGE",
            "MONEY",
            "TEXT",
            "BOX_CODE",
            "STATEMENT"
          ]
        },
        "sourceField": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Form-oriented source concept such as part_i_a or section_l_ending_capital."
        },
        "box": {
          "type": ["string", "null"],
          "maxLength": 20
        },
        "code": {
          "type": ["string", "null"],
          "pattern": "^[A-Z0-9]{1,8}$"
        },
        "label": { "$ref": "#/$defs/nullableText" },
        "statementReference": { "$ref": "#/$defs/nullableText" },
        "rawText": { "$ref": "#/$defs/nullableText" },
        "normalizedText": { "$ref": "#/$defs/nullableText" },
        "normalizedAmount": { "$ref": "#/$defs/money" },
        "normalizedBoolean": { "type": ["boolean", "null"] },
        "needsReview": { "type": "boolean" },
        "explanation": {
          "type": ["string", "null"],
          "maxLength": 1000,
          "description": "Short uncertainty explanation only; never chain-of-thought."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "MONEY" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "normalizedAmount": { "$ref": "#/$defs/money" },
              "normalizedBoolean": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "CHECKBOX" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "normalizedAmount": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "STATEMENT" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "needsReview": { "const": true }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "providerField",
        "rawText",
        "confidence",
        "page",
        "bbox"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["TEXTRACT", "BEDROCK_BDA", "BEDROCK_LLM"]
        },
        "providerField": { "type": ["string", "null"], "maxLength": 300 },
        "rawText": { "$ref": "#/$defs/nullableText" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "bbox": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height", "pageWidth", "pageHeight", "unit"],
              "properties": {
                "x": { "type": "number", "minimum": 0 },
                "y": { "type": "number", "minimum": 0 },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "pageWidth": { "type": "number", "exclusiveMinimum": 0 },
                "pageHeight": { "type": "number", "exclusiveMinimum": 0 },
                "unit": { "type": "string", "enum": ["PIXEL", "POINT", "RATIO"] }
              }
            }
          ]
        }
      }
    }
  }
}
